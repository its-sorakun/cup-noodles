{
  "name": "cup-noodles",
  "version": "1.1.1",
  "description": "homelab media server — browse & stream your personal media collection",
  "license": "ISC",
  "author": "its-sorakun",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "tailwindcss -i ./public/tailwind-input.css -o ./public/tailwind.css --minify",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --win"
  },
  "build": {
    "appId": "com.cupnoodles.app",
    "productName": "Cup-Noodles",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/img/icon.png"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "files": [
      "main.js",
      "server.js",
      "mediascanner.js",
      "routes/**/*",
      "services/**/*",
      "middlewares/**/*",
      "public/**/*",
      "config.json",
      "auth.json",
      "package.json"
    ]
  },
  "keywords": [
    "media-server",
    "homelab",
    "streaming"
  ],
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^3.0.1",
    "sharp": "^0.34.2",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}